{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "we",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "d6d2ac72-e4ef-4bf0-84d7-0171d2564cf9","database_name": "webaref" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "7d1eed51d8de4c718e35a03f289041f6" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
